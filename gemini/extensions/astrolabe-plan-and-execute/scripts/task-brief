#!/usr/bin/env bash
# Extract one task's (or subcomponent's) full text from a phase file into a
# file the implementor reads in one call, so the task text never has to be
# pasted through the controller's context.
#
# Usage: task-brief PHASE_FILE TASK [OUTFILE]
#   TASK is a number (1, 2, ...) for a single task, or a letter (A, B, ...)
#   for a subcomponent covering several tasks.
#
# Default OUTFILE: <repo-root>/.astrolabe/exec/task-<TASK>-brief.md
# (per worktree; concurrent runs in the same working tree share it).
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief PHASE_FILE TASK [OUTFILE]" >&2
  exit 2
fi

phase=$1
task=$2
[ -f "$phase" ] || { echo "no such phase file: $phase" >&2; exit 2; }

case "$task" in
  [0-9]*) marker=TASK ;;
  [A-Za-z]) marker=SUBCOMPONENT; task=$(printf '%s' "$task" | tr '[:lower:]' '[:upper:]') ;;
  *) echo "TASK must be a number (task) or a single letter (subcomponent): $task" >&2; exit 2 ;;
esac

if [ $# -eq 3 ]; then
  out=$3
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/astrolabe-workspace")
  out="$dir/task-${task}-brief.md"
fi

awk -v start="START_${marker}_${task}" -v end="END_${marker}_${task}" '
  index($0, "<!-- " start " ") == 1 { intask = 1 }
  intask { print }
  index($0, "<!-- " end " -->") == 1 { intask = 0 }
' "$phase" > "$out"

if [ ! -s "$out" ]; then
  echo "no ${marker} ${task} in ${phase} (looked for '<!-- START_${marker}_${task}')" >&2
  exit 3
fi

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
