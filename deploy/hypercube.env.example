# Copy to .env in the repository root and edit for your server.
HYPERCUBE_CONFIG_PATH=./deploy/hypercube/projects.json
HYPERCUBE_PROJECTS_ROOT=/srv/projects
HYPERCUBE_BIND_ADDRESS=127.0.0.1
HYPERCUBE_PORT=8765
# The selected host UID/GID needs read access to the mounted project files.
HYPERCUBE_UID=1000
HYPERCUBE_GID=1000
